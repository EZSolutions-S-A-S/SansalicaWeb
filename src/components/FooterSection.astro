---
import logo from '../assets/logo-dorado.svg';
const PHONE     = import.meta.env.PUBLIC_PHONE     || '313-774-9371';
const EMAIL     = import.meta.env.PUBLIC_EMAIL     || 'contacto@sansalica.com';
const INSTAGRAM = import.meta.env.PUBLIC_INSTAGRAM || 'https://www.instagram.com';
const LINKEDIN  = import.meta.env.PUBLIC_LINKEDIN  || 'https://www.linkedin.com';
const FACEBOOK  = import.meta.env.PUBLIC_FACEBOOK  || 'https://www.facebook.com';
---

<footer class="footer">
  <div class="footer__inner">

    
    <div class="footer__col footer__col--brand">
      <img src={logo.src} alt="Sansalica" class="footer__logo" />
    </div>

    
    <div class="footer__col">
      <h4 class="footer__heading">Servicios</h4>
      <ul class="footer__list">
        <li>Compra de inmuebles</li>
        <li>Venta de inmuebles</li>
        <li>Arriendo de inmuebles</li>
        <li>Asesoría inmobiliaria</li>
      </ul>
    </div>

    
    <div class="footer__col">
      <h4 class="footer__heading">Explora</h4>
      <ul class="footer__list footer__list--links">
        <li><a href="/catalogo">Catálogo de inmuebles</a></li>
        <li><a href="/nosotros">Nosotros</a></li>
        <li><a href="/contacto">Contáctanos</a></li>
      </ul>
    </div>

    
    <div class="footer__col">
      <h4 class="footer__heading">Contacto</h4>
      <ul class="footer__list footer__list--contact">
        <li>
          <span class="footer__contact-icon" aria-hidden="true">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
              <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 12 19.79 19.79 0 0 1 1.63 3.4 2 2 0 0 1 3.6 1.22h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L7.91 8.82a16 16 0 0 0 6.29 6.29l.97-.97a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/>
            </svg>
          </span>
          <a href={`tel:${PHONE.replace(/-/g, '')}`}>{PHONE}</a>
        </li>
        <li>
          <span class="footer__contact-icon" aria-hidden="true">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
              <rect width="20" height="16" x="2" y="4" rx="2"/>
              <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/>
            </svg>
          </span>
          <a href={`mailto:${EMAIL}`}>{EMAIL}</a>
        </li>
      </ul>

      
      <div class="footer__social">
        <a href={INSTAGRAM} target="_blank" rel="noopener noreferrer" aria-label="Instagram de Sansalica" class="footer__social-link">
          <svg width="28" height="28" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
          </svg>
        </a>
        <a href={LINKEDIN} target="_blank" rel="noopener noreferrer" aria-label="LinkedIn de Sansalica" class="footer__social-link">
          <svg width="28" height="28" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
          </svg>
        </a>
        <a href={FACEBOOK} target="_blank" rel="noopener noreferrer" aria-label="Facebook de Sansalica" class="footer__social-link">
          <svg width="28" height="28" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
          </svg>
        </a>
      </div>
    </div>

  </div>

  
  <div class="footer__bottom">
    <hr class="footer__divider" />
    <p class="footer__copy">© 2026 Sansalica Inmobiliaria. Todos los derechos reservados.</p>
  </div>
</footer>

<style>
  .footer {
    background-color: #13233C;
    padding: 4rem 2rem 2rem;
  }

  .footer__inner {
    max-width: 1100px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1.2fr 1fr 1fr 1.2fr;
    gap: 3rem;
    padding-bottom: 3rem;
  }

  
  .footer__col--brand {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
  }

  .footer__logo {
    height: 115px;
    width: auto;
    
  }

  
  .footer__heading {
    font-family: var(--font-primary);
    font-size: 1rem;
    font-weight: 600;
    color: #C9A96E;
    margin-bottom: 1.25rem;
    letter-spacing: 0.02em;
  }

  
  .footer__list {
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
  }

  .footer__list li {
    font-family: var(--font-primary);
    font-size: 0.9rem;
    color: rgba(255, 255, 255, 0.75);
    line-height: 1.4;
  }

  .footer__list--links li a {
    color: rgba(255, 255, 255, 0.75);
    transition: color 0.2s ease;
  }

  .footer__list--links li a:hover {
    color: #C9A96E;
  }

  
  .footer__list--contact li {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }

  .footer__contact-icon {
    color: #C9A96E;
    display: flex;
    flex-shrink: 0;
  }

  .footer__list--contact a {
    color: rgba(255, 255, 255, 0.75);
    font-size: 0.9rem;
    transition: color 0.2s ease;
  }

  .footer__list--contact a:hover {
    color: #C9A96E;
  }

  
  .footer__social {
    display: flex;
    gap: 1.25rem;
    margin-top: 1.5rem;
    align-items: center;
  }

  .footer__social-link {
    color: #C9A96E;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: opacity 0.2s ease, transform 0.2s ease;
  }

  .footer__social-link:hover {
    opacity: 0.80;
    transform: translateY(-2px);
  }

  
  .footer__bottom {
    max-width: 1100px;
    margin: 0 auto;
  }

  .footer__divider {
    border: none;
    border-top: 1px solid rgba(224, 225, 226, 0.18);
    margin-bottom: 1.5rem;
  }

  .footer__copy {
    font-family: var(--font-primary);
    font-size: 0.82rem;
    color: rgba(255, 255, 255, 0.45);
    text-align: center;
    letter-spacing: 0.01em;
  }

  
  @media (max-width: 992px) {
    .footer__inner {
      grid-template-columns: 1fr 1fr;
      gap: 2.5rem;
    }
  }

  @media (max-width: 600px) {
    .footer {
      padding: 3rem 1.25rem 1.5rem;
    }

    .footer__inner {
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    .footer__col--brand {
      align-items: center;
    }
  }
</style>
