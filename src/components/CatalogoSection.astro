---
import FiltrosSidebar from './FiltrosSidebar.astro';
import CatalogoGrid from './CatalogoGrid.astro';
import { buildInmueblesQuery } from '../lib/inmuebles';

const { filters, queryString } = buildInmueblesQuery(Astro.url.searchParams);
---

<section class="catalogo-section">
  <div class="catalogo-container">
    <header class="catalogo-header">
      <span class="catalogo-header__subtitle">Portafolio completo</span>
      <h2 class="catalogo-header__title">Catálogo de Inmuebles</h2>
    </header>

    <div class="catalogo-layout">
      <div class="catalogo-sidebar">
        <FiltrosSidebar filters={filters} basePath="/catalogo" />
      </div>

      <CatalogoGrid server:defer queryString={queryString}>
        <div class="catalogo-grid" id="catalogo-grid" slot="fallback">
          {Array.from({ length: 6 }).map(() => (
            <div class="property-card-skeleton">
              <div class="property-card-skeleton__image"></div>
              <div class="property-card-skeleton__content">
                <div class="property-card-skeleton__bar property-card-skeleton__bar--title"></div>
                <div class="property-card-skeleton__bar" style="width: 60%"></div>
                <div class="property-card-skeleton__bar property-card-skeleton__bar--price"></div>
              </div>
            </div>
          ))}
        </div>
      </CatalogoGrid>
    </div>
  </div>
</section>

<style>
  .catalogo-section {
    background-color: var(--color-cream);
    padding: 2.5rem 1.5rem 4rem;
  }

  .catalogo-container {
    max-width: 1200px;
    margin: 0 auto;
  }

  .catalogo-header {
    margin-bottom: 2.5rem;
  }

  .catalogo-header__subtitle {
    display: block;
    font-family: var(--font-primary);
    color: var(--color-gold);
    font-size: 1.25rem;
    font-weight: 500;
    margin-bottom: 0.25rem;
  }

  .catalogo-header__title {
    font-family: var(--font-primary);
    color: var(--color-navy);
    font-size: clamp(2.5rem, 5vw, 3.5rem);
    font-weight: 700;
    line-height: 1.1;
  }

  .catalogo-layout {
    display: grid;
    grid-template-columns: 320px 1fr;
    gap: 2.5rem;
    align-items: start;
  }

  /* ── Responsive ── */
  @media (max-width: 992px) {
    .catalogo-layout {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 768px) {
    .catalogo-section {
      padding: 2rem 1rem 3rem;
    }
  }
</style>
