---
import logo from '../assets/logo.svg';

export interface Props {
  activeLink?: 'inicio' | 'inmuebles' | 'nosotros' | 'contacto';
}

const { activeLink = 'inicio' } = Astro.props;

const links = [
  { label: 'Inicio',    href: '/',          key: 'inicio'    },
  { label: 'Inmuebles', href: '/catalogo',  key: 'inmuebles' },
  { label: 'Nosotros',  href: '/nosotros',   key: 'nosotros'  },
  { label: 'Contacto',  href: '/contacto',   key: 'contacto'  },
] as const;
---

<nav class="navbar-container" aria-label="Navegación principal">
  <a href="/" class="navbar__logo" aria-label="Sansalica — Ir al inicio">
    <img src={logo.src} alt="Sansalica" class="navbar__logo-img" />
  </a>

  <ul class="navbar__links">
    {links.map((link) => (
      <li>
        <a
          href={link.href}
          class:list={[
            'navbar__link',
            { 'navbar__link--active': link.key === activeLink }
          ]}
        >
          {link.label}
        </a>
      </li>
    ))}
  </ul>
</nav>

<style>
  .navbar-container {
    width: 90%;
    max-width: 1200px;
    border-radius: 9999px;
    background: rgba(255, 255, 255, 0.9);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    padding: 0.9rem 2.5rem;
    box-shadow: 0 4px 25px rgba(0, 0, 0, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.35);
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .navbar__logo {
    display: flex;
    align-items: center;
    flex-shrink: 0;
  }

  .navbar__logo-img {
    height: 45px;
    width: auto;
  }

  .navbar__links {
    display: flex;
    align-items: center;
    gap: 2.5rem;
  }

  .navbar__link {
    display: inline-block;
    padding: 0.4rem;
    font-family: var(--font-primary);
    font-size: 1.05rem;
    font-weight: 500;
    color: var(--color-navy);
    transition: color 0.2s ease, background-color 0.2s ease;
  }

  .navbar__link:hover {
    color: var(--color-gold);
  }

  .navbar__link--active {
    color: var(--color-gold);
    font-weight: 600;
  }

  /* ── Responsive ── */
  @media (max-width: 768px) {
    .navbar-container {
      width: calc(100% - 2rem);
      padding: 0.6rem 1rem;
      border-radius: 16px;
      flex-wrap: wrap;
      gap: 0.5rem;
    }

    .navbar__logo-img {
      height: 30px;
    }

    .navbar__links {
      gap: 0;
      flex-wrap: wrap;
    }

    .navbar__link {
      font-size: 0.8rem;
      padding: 0.3rem 0.65rem;
    }
  }

  @media (max-width: 400px) {
    .navbar-container {
      justify-content: center;
    }

    .navbar__links {
      justify-content: center;
      width: 100%;
    }
  }
</style>
