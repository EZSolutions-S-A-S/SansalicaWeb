---
import logo from '../assets/logo.svg';

export interface Props {
  activeLink?: 'inicio' | 'inmuebles' | 'nosotros' | 'contacto';
  variant?: 'fixed' | 'page';
  anchorMode?: boolean;
}

const { activeLink = 'inicio', variant = 'fixed', anchorMode = false } = Astro.props;

const links = [
  { label: 'Inicio',    href: '/#inicio',    key: 'inicio'    },
  { label: 'Inmuebles', href: '/catalogo',   key: 'inmuebles' },
  { label: 'Nosotros',  href: '/#nosotros',  key: 'nosotros'  },
  { label: 'Contacto',  href: '/#contacto',  key: 'contacto'  },
];
---

<header class:list={['navbar-wrapper', { 'navbar-wrapper--page': variant === 'page' }]}>
  <nav class="navbar" aria-label="Navegación principal">
    <a href="/#inicio" class="navbar__logo" aria-label="Sansalica — Ir al inicio">
      <img src={logo.src} alt="Sansalica" class="navbar__logo-img" />
    </a>

    <ul class="navbar__links">
      {links.map((link) => (
        <li>
          <a
            href={link.href}
            data-nav-key={link.key}
            class:list={[
              'navbar__link',
              { 'navbar__link--active': link.key === activeLink }
            ]}
          >
            {link.label}
          </a>
        </li>
      ))}
    </ul>
  </nav>
</header>

<style is:global>
  .navbar-wrapper {
    position: fixed;
    top: 2rem;
    left: 50%;
    transform: translateX(-50%);
    width: calc(100% - 4rem);
    max-width: 1100px;
    z-index: 1000;
  }

  .navbar-wrapper--page {
    position: relative;
    top: auto;
    left: auto;
    transform: none;
    width: calc(100% - 4rem);
    max-width: 1100px;
    margin: 1.5rem auto 0;
    z-index: 100;
  }

  .navbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.9rem 2.5rem;
    background: var(--color-navbar-bg);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-radius: 20px;
    border: 1px solid rgba(255, 255, 255, 0.35);
    transition: background 0.4s ease, border-color 0.4s ease;
  }

  .navbar__logo {
    display: flex;
    align-items: center;
    flex-shrink: 0;
  }

  .navbar__logo-img {
    height: 45px;
    width: auto;
  }

  .navbar__links {
    display: flex;
    align-items: center;
    gap: 2.5rem;
  }

  .navbar__link {
    display: inline-block;
    padding: 0.4rem;
    font-family: var(--font-primary);
    font-size: 1.05rem;
    font-weight: 500;
    color: var(--color-navy);
    border-radius: 20px;
    transition: color 0.2s ease, background-color 0.2s ease;
  }

  .navbar__link:hover {
    color: var(--color-gold);
  }

  .navbar__link--active {
    color: var(--color-gold);
    font-weight: 600;
  }

  
  @media (max-width: 768px) {
    .navbar-wrapper {
      top: 1rem;
      width: calc(100% - 2rem);
    }

    .navbar-wrapper--page {
      top: auto;
      width: calc(100% - 2rem);
      margin: 1rem auto 0;
    }

    .navbar {
      padding: 0.6rem 1rem;
      border-radius: 16px;
      flex-wrap: wrap;
      gap: 0.5rem;
    }

    .navbar__logo-img {
      height: 30px;
    }

    .navbar__links {
      gap: 0;
      flex-wrap: wrap;
    }

    .navbar__link {
      font-size: 0.8rem;
      padding: 0.3rem 0.65rem;
    }
  }

  @media (max-width: 400px) {
    .navbar {
      justify-content: center;
    }

    .navbar__links {
      justify-content: center;
      width: 100%;
    }
  }

  /* Cuando el navbar está dentro de un wrapper de página (ej. detalle de inmueble) */
  .detail-nav-wrapper .navbar-wrapper {
    position: relative;
    top: auto;
    left: auto;
    transform: none;
    width: calc(100% - 4rem);
    max-width: 1100px;
    margin: 0 auto;
  }

  /* Mejoras móvil */
  @media (max-width: 560px) {
    .navbar__links {
      gap: 0.25rem;
    }
    .navbar__link {
      font-size: 0.75rem;
      padding: 0.25rem 0.5rem;
    }
    .navbar__logo-img {
      height: 28px;
    }
  }
</style>
