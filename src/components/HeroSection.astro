---
import heroBg from '../assets/hero-bg.png';
---

<section
  id="hero"
  class="hero"
  style={`--hero-bg: url('${heroBg.src}')`}
  aria-label="Sección principal"
>
  <div class="hero__overlay" aria-hidden="true"></div>

  <div class="hero__content">
    <p class="hero__eyebrow">Inmobiliaria Sansalica</p>

    <h1 class="hero__title">
      Encuentra el hogar<br />
      <span class="hero__title--accent">que mereces</span>
    </h1>

    <p class="hero__description">
      Propiedades exclusivas en las mejores ciudades de<br class="hero__description-br" />
      Colombia. Asesoría personalizada y discreción garantizada.
    </p>

    <div class="hero__actions">
      <a href="#catalogo" class="btn btn--primary">Ver catálogo</a>
      <a href="#nosotros" class="btn btn--secondary">Quiénes somos</a>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    width: 100%;
    min-height: 100vh;
    background-image: var(--hero-bg);
    background-size: cover;
    background-position: center center;
    background-repeat: no-repeat;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  .hero__overlay {
    position: absolute;
    inset: 0;
    background-color: var(--color-overlay);
    z-index: 1;
  }

  .hero__content {
    position: relative;
    z-index: 2;
    text-align: center;
    padding: 10rem 1.5rem 3rem;
    max-width: 820px;
    width: 100%;
  }

  .hero__eyebrow {
    font-family: var(--font-primary);
    font-size: 0.95rem;
    font-weight: 400;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-white);
    opacity: 0.88;
    margin-bottom: 1.25rem;
  }

  .hero__title {
    font-family: var(--font-primary);
    font-size: clamp(2.75rem, 7vw, 5.25rem);
    font-weight: 700;
    line-height: 1.12;
    color: var(--color-white);
    margin-bottom: 1.75rem;
  }

  .hero__title--accent {
    color: var(--color-gold);
  }

  .hero__description {
    font-family: var(--font-primary);
    font-size: clamp(0.9rem, 1.8vw, 1.05rem);
    font-weight: 400;
    line-height: 1.75;
    color: var(--color-white);
    opacity: 0.88;
    margin-bottom: 2.75rem;
  }

  .hero__actions {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .btn {
    display: inline-block;
    padding: 0.85rem 2.1rem;
    font-family: var(--font-primary);
    font-size: 0.95rem;
    font-weight: 600;
    border-radius: 50px;
    transition: opacity 0.2s ease, transform 0.2s ease;
    cursor: pointer;
    white-space: nowrap;
  }

  .btn:hover {
    opacity: 0.88;
    transform: translateY(-2px);
  }

  .btn:active {
    transform: translateY(0);
    opacity: 1;
  }

  .btn--primary {
    background-color: var(--color-gold);
    color: var(--color-white);
    border: 2px solid var(--color-gold);
  }

  .btn--secondary {
    background-color: var(--color-btn-ghost-bg);
    color: var(--color-white);
    border: 2px solid var(--color-btn-ghost-border);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
  }

  /* ── Responsive ── */
  @media (max-width: 768px) {
    .hero__content {
      padding: 8rem 1.25rem 3rem;
    }

    .hero__description-br {
      display: none;
    }

    .hero__actions {
      flex-direction: column;
      align-items: center;
    }

    .btn {
      width: 100%;
      max-width: 280px;
      text-align: center;
    }
  }

  @media (max-width: 480px) {
    .hero__title {
      font-size: 2.25rem;
    }

    .hero__eyebrow {
      font-size: 0.8rem;
      letter-spacing: 0.12em;
    }
  }
</style>
