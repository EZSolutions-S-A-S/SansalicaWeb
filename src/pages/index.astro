---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import HeroSection from '../components/HeroSection.astro';
import NosotrosSection from '../components/NosotrosSection.astro';
import CTASection from '../components/CTASection.astro';
import FooterSection from '../components/FooterSection.astro';
---

<Layout title="Sansalica — Inmobiliaria">
  <Navbar activeLink="inicio" anchorMode={true} />

  <HeroSection />

  <div id="catalogo" data-section="catalogo" class="catalogo-placeholder">
    <p class="catalogo-placeholder__text">Catálogo de inmuebles próximamente</p>
  </div>

  <div id="nosotros" data-section="nosotros">
    <NosotrosSection />
  </div>

  <div id="contacto" data-section="contacto">
    <CTASection />
    <FooterSection />
  </div>
</Layout>

<style>
  #nosotros {
    scroll-margin-top: 90px;
  }

  .catalogo-placeholder {
    min-height: 100vh;
    background-color: var(--color-page-bg);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .catalogo-placeholder__text {
    font-family: var(--font-primary);
    font-size: 1.1rem;
    color: var(--color-navy);
    opacity: 0.5;
  }
</style>

<script>
  const sections = [
    { id: 'hero',     key: 'inicio'    },
    { id: 'catalogo', key: 'inmuebles' },
    { id: 'nosotros', key: 'nosotros'  },
    { id: 'contacto', key: 'contacto'  },
  ];

  function setActive(key) {
    document.querySelectorAll('.navbar__link').forEach(link => {
      link.classList.toggle('navbar__link--active', link.dataset.navKey === key);
    });
  }

  const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        const key = entry.target.dataset.navKey;
        if (key) setActive(key);
      }
    });
  }, { threshold: 0, rootMargin: '-45% 0px -45% 0px' });

  sections.forEach(({ id, key }) => {
    const el = document.getElementById(id);
    if (el) {
      el.dataset.navKey = key;
      observer.observe(el);
    }
  });
</script>

