---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import HeroSection from '../components/HeroSection.astro';
import PropiedadesDestacadas from '../components/PropiedadesDestacadas.astro';
import NosotrosSection from '../components/NosotrosSection.astro';
import CTASection from '../components/CTASection.astro';
import FooterSection from '../components/FooterSection.astro';
---

<Layout title="Sansalica — Inmobiliaria">
  <Navbar activeLink="inicio" />

  <div id="inicio" data-section="inicio">
    <HeroSection />
  </div>

  <div id="inmuebles" data-section="inmuebles">
    <PropiedadesDestacadas server:defer>
      <div class="featured-skeleton" slot="fallback">
        <div class="property-card-skeleton">
          <div class="property-card-skeleton__image"></div>
          <div class="property-card-skeleton__content">
            <div class="property-card-skeleton__bar property-card-skeleton__bar--title"></div>
            <div class="property-card-skeleton__bar" style="width: 60%"></div>
            <div class="property-card-skeleton__bar property-card-skeleton__bar--price"></div>
          </div>
        </div>
        <div class="property-card-skeleton">
          <div class="property-card-skeleton__image"></div>
          <div class="property-card-skeleton__content">
            <div class="property-card-skeleton__bar property-card-skeleton__bar--title"></div>
            <div class="property-card-skeleton__bar" style="width: 60%"></div>
            <div class="property-card-skeleton__bar property-card-skeleton__bar--price"></div>
          </div>
        </div>
        <div class="property-card-skeleton">
          <div class="property-card-skeleton__image"></div>
          <div class="property-card-skeleton__content">
            <div class="property-card-skeleton__bar property-card-skeleton__bar--title"></div>
            <div class="property-card-skeleton__bar" style="width: 60%"></div>
            <div class="property-card-skeleton__bar property-card-skeleton__bar--price"></div>
          </div>
        </div>
      </div>
    </PropiedadesDestacadas>
  </div>

  <div id="nosotros" data-section="nosotros">
    <NosotrosSection />
  </div>

  <div id="contacto" data-section="contacto">
    <CTASection />
    <FooterSection />
  </div>
</Layout>

<style>
  #nosotros, #inmuebles, #contacto {
    scroll-margin-top: 90px;
  }

  /* Fallback del server island de Propiedades Destacadas: mismo contenedor/grid
     que .featured-properties-container/.featured-grid (PropiedadesDestacadas.astro)
     para que no salte el layout mientras se resuelve la petición. */
  .featured-skeleton {
    width: calc(100% - 4rem);
    max-width: 1100px;
    margin: 2.5rem auto 0;
    padding: 5rem 0 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
    box-sizing: border-box;
  }

  @media (max-width: 1024px) {
    .featured-skeleton {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 640px) {
    .featured-skeleton {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  const sections = [
    { id: 'inicio',    key: 'inicio'    },
    { id: 'inmuebles', key: 'inmuebles' },
    { id: 'nosotros',  key: 'nosotros'  },
    { id: 'contacto',  key: 'contacto'  },
  ];

  function setActive(key) {
    document.querySelectorAll('.navbar__link').forEach(link => {
      link.classList.toggle('navbar__link--active', link.dataset.navKey === key);
    });
  }

  const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        const key = entry.target.dataset.navKey;
        if (key) setActive(key);
      }
    });
  }, { threshold: 0, rootMargin: '-45% 0px -45% 0px' });

  sections.forEach(({ id, key }) => {
    const el = document.getElementById(id);
    if (el) {
      el.dataset.navKey = key;
      observer.observe(el);
    }
  });
</script>

